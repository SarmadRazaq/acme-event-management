# Copy this file to `.env` and adjust the values for your machine.

# PostgreSQL connection (async driver: asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/acme_events

# Separate database used by the pytest suite (it is dropped and recreated on every run)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/acme_events_test

# JWT settings. Generate a strong secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://localhost

# Print SQL statements (useful while learning, noisy in production)
SQL_ECHO=false
