# Settings for `docker compose` (copy to .env). For running the backend without Docker,
# see backend/.env.example instead.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=acme_events

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080
WEB_CONCURRENCY=2

# Host ports
APP_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
